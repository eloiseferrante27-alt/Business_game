# Copier en .env (scripts\setup.ps1 le fait automatiquement). Ne jamais committer .env.
GMIX_ENV=dev
LOG_LEVEL=INFO

# --- PostgreSQL + pgvector (Docker) ---
# Port hôte 5433 : le 5432 est déjà pris par le service Windows postgresql-x64-18.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=gmix
POSTGRES_PASSWORD=gmix_dev
POSTGRES_DB=gmix

# --- Kafka (KRaft, Docker) ---
KAFKA_PORT=9092
KAFKA_BOOTSTRAP=localhost:9092

# --- Stockage objet S3 (RustFS, Docker) ---
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=gmixadmin
S3_SECRET_KEY=gmix-dev-secret
S3_BUCKET_ASSETS=gmix-assets
S3_BUCKET_KNOWLEDGE=gmix-knowledge
S3_BUCKET_GAMES=gmix-games
# Jeu en réseau local / à distance : adresse S3 que les joueurs peuvent joindre (URL présignées),
# ex. http://192.168.1.20:9000 en salle, https://s3.mon-domaine.fr à distance. Vide = S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=
# 0.0.0.0 pour exposer l'API S3 au réseau local (seulement si des assets sont téléchargés à la volée)
S3_BIND_ADDRESS=127.0.0.1

# --- Ollama (natif Windows, GPU) ---
# Aujourd'hui sur ce poste. Pour déplacer l'IA sur un serveur GPU : son URL ici, et OLLAMA_API_KEY si le serveur
# est derrière un reverse proxy qui exige un jeton (Ollama seul n'a pas d'authentification : ne pas l'exposer nu).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_EXE=C:\Users\Flash\AppData\Local\Programs\Ollama\ollama.exe

# --- Corpus RAG ---
# Contact exigé par Wikimédia pour télécharger des articles (e-mail ou URL du projet), ASCII uniquement
WIKI_CONTACT=

# --- API FastAPI ---
# Réseau local : .\scripts\api.ps1 -Lan (écoute sur 0.0.0.0). API_BIND_ADDRESS : idem pour le profil Docker "app".
API_HOST=127.0.0.1
API_PORT=8000
API_BIND_ADDRESS=127.0.0.1
CORS_ORIGINS=*
# Signe les jetons de connexion et les tickets de présence (serveurs de partie Godot). scripts\setup.ps1 remplace
# cette valeur par 64 caractères aléatoires ; l'API refuse un secret de moins de 32 caractères.
JWT_SECRET=a-generer-par-setup

# --- Godot ---
GODOT_EXE=C:\Godot_v4.7.2-stable_win64.exe\Godot_v4.7.2-stable_win64.exe
GODOT_CONSOLE_EXE=C:\Godot_v4.7.2-stable_win64.exe\Godot_v4.7.2-stable_win64_console.exe
# Serveurs de partie (présence des joueurs, ADR 0005) : un processus Godot headless par lobby, lancé par l'API
# avec GODOT_CONSOLE_EXE. Ports UDP à autoriser dans le pare-feu Windows pour jouer en salle.
GAME_SERVER_PORTS=7000-7049
